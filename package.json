{
  "name": "hotel-management-backend",
  "version": "1.0.0",
  "description": "Hotel Management System REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed-mongodb.js",
    "backup:postgres": "node scripts/backup-postgres.js",
    "backup:mongodb": "node scripts/mongodb-backup.js backup",
    "restore:mongodb": "node scripts/mongodb-backup.js restore",
    "migrate:to-mongodb": "node scripts/migrate-to-mongodb.js",
    "migrate:dry-run": "node scripts/migrate-to-mongodb.js --dry-run",
    "migrate:rollback": "node scripts/migrate-to-mongodb.js --rollback",
    "migrate:validate": "node scripts/validate-migration.js",
    "migrate:start": "node scripts/migration-workflow.js"
  },
  "dependencies": {
    "@stormkit/serverless": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "pg": "^8.13.0",
    "serverless-http": "^4.0.0"
  }
}
